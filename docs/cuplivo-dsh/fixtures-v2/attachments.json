            "type": "text",
            "text": "Reply with just: OK"
          },
          {
            "type": "file",
            "receiptId": "<receiptId>"
          }
        ]
      }
    },
    "value": {
      "accepted": true
    },
    "note": "a receipt from an image upload enters the message as that image; an image may also be sent inline as {type:image, mediaType, data:<base64>}"
