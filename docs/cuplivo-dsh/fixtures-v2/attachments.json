        "attachmentId": "<attachmentId>",
        "mediaType": "image/png",
        "bytes": 189,
        "width": 8,
        "height": 8,
        "name": "pixel.png"
      },
      "data": "<canonical base64; 252 chars for this 189-byte PNG>"
    },
    "note": "the transcript re-reads an image by its full durable reference; the reference identity is the sha256 content id, so a rewritten name/dimension set is rejected by verification"
  },
  "file_route": {
    "request": {
      "method": "GET",
      "path": "/api/file?path=<url-encoded absolute path>"
    },
    "first_response": {
      "status": 302,
      "headers": {
        "cache-control": "private, no-store",
        "content-security-policy": "sandbox; default-src 'none'",
        "location": "?path=<encoded absolute path>&v=<opaque-version>",
        "x-content-type-options": "nosniff"
      }
    },
    "final_response": {
      "status": 200,
      "headers": {
        "content-type": "image/png (mime by extension)",
        "content-length": "189",
        "cache-control": "private, max-age=31536000, immutable",
        "content-security-policy": "sandbox; default-src 'none'",
        "x-content-type-options": "nosniff",
        "vary": "Accept-Encoding"
      }
    },
    "note": "authenticated by the same cookie; the redirect pins the versioned URL which is then cacheable. Markdown body images and previews use this route rather than readBytes"
  }
