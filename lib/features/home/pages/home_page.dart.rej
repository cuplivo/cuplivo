-      child: ConstrainedBox(
-        constraints: BoxConstraints(
-          maxWidth: constrainedWidth,
-          maxHeight: MediaQuery.sizeOf(context).height,
-        ),
-        child: Material(
-          color: panelColor,
-          borderRadius: BorderRadius.circular(18),
-          child: Padding(
