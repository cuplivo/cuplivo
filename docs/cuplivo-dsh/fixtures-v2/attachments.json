  "_source": "real DSH Host (0.2.2-rc.1), captured 2026-11-20; ids/host/paths redacted",
  "upload_route": {
    "request": {
      "method": "POST",
      "path": "/api/session/uploadFileBinary?sessionId=<sessionId>&name=pixel.png&mediaType=image/png",
      "headers": {
        "content-type": "application/octet-stream"
      },
      "body": "the raw file bytes (a 189-byte 8x8 PNG here)"
    },
    "response": {
      "ok": true,
      "value": {
        "receiptId": "<receiptId>",
        "image": {
          "attachmentId": "<attachmentId>",
          "mediaType": "image/png",
          "width": 8,
          "height": 8,
          "bytes": 189,
          "name": "pixel.png"
        }
      }
    },
    "note": "without mediaType the value is {receiptId, file}; with mediaType it is {receiptId, image}. 405/415/400 are carrier answers for method/content-type/missing sessionId; business failures come back as HTTP 200 {ok:false,error}"
  },
  "rpc_fallback": {
    "method": "fileUploads/upload",
    "args": {
      "agentId": "<sessionId>",
      "request": {
        "data": "<canonical base64>",
        "name": "notes.txt"
      }
    },
    "value": {
      "receiptId": "<receiptId>",
      "file": {
        "attachmentId": "<attachmentId>",
        "name": "notes.txt",
        "bytes": 164
      }
    }
  },
